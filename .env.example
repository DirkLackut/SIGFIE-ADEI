# Copiar como .env.local y llenar con los valores del proyecto en Supabase.
# .env.local NO se versiona (ver .gitignore). Nunca pegar estas claves en el chat.

# Panel de Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Panel de Supabase → Project Settings → API Keys → service_role (secreta).
# Solo se usa en el servidor, para registrar en la auditoría los ingresos
# fallidos, que ocurren sin usuario autenticado (plan §8).
SUPABASE_SERVICE_ROLE_KEY=

# Solo para `npm run verificar:supabase` (tarea T16), nunca para la app.
# Panel de Supabase → botón "Connect" (arriba) → pestaña "Connection String" →
# "Session pooler". Copiar la cadena y cambiar [YOUR-PASSWORD] por la contraseña
# de la base. Lleva la contraseña: solo en .env.local, nunca en el chat.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
